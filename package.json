{
  "name": "boxlite-cloud",
  "displayName": "BoxLite Cloud",
  "description": "Deploy and manage BoxLite cloud applications with ease",
  "version": "0.1.1",
  "publisher": "FD-System-Holdings",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "boxlite",
    "cloud",
    "deploy",
    "microvms",
    "containers",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FD-System-Holdings/Boxlite-Cloud-VSCode-Extension"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "boxlite-explorer",
          "title": "BoxLite",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "boxlite-explorer": [
        {
          "id": "boxlite.accountView",
          "name": "BoxLite Cloud Account",
          "icon": "$(account)",
          "visibility": "visible"
        },
        {
          "id": "boxlite.secretsView",
          "name": "Secrets",
          "icon": "$(shield)",
          "visibility": "visible"
        },
        {
          "id": "boxlite.boxesView",
          "name": "Boxes",
          "icon": "$(vm)",
          "visibility": "visible"
        },
        {
          "id": "boxlite.imagesView",
          "name": "Images",
          "icon": "$(package)",
          "visibility": "visible"
        },
        {
          "id": "boxlite.volumesView",
          "name": "Volumes",
          "icon": "$(database)",
          "visibility": "visible"
        },
        {
          "id": "boxlite.checkpointsView",
          "name": "Checkpoints",
          "icon": "$(archive)",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "boxlite.setApiKey",
        "title": "Sign In / Set API Key",
        "category": "BoxLite",
        "icon": "$(key)"
      },
      {
        "command": "boxlite.selectApiKey",
        "title": "Select Active API Key...",
        "category": "BoxLite",
        "icon": "$(key)"
      },
      {
        "command": "boxlite.removeApiKey",
        "title": "Remove API Key",
        "category": "BoxLite",
        "icon": "$(trash)"
      },
      {
        "command": "boxlite.signOut",
        "title": "Log Out",
        "category": "BoxLite",
        "icon": "$(sign-out)"
      },
      {
        "command": "boxlite.refresh",
        "title": "Refresh",
        "category": "BoxLite",
        "icon": "$(refresh)"
      },
      {
        "command": "boxlite.setupEnvironment",
        "title": "Set Up Python Environment",
        "category": "BoxLite",
        "icon": "$(tools)"
      },
      {
        "command": "boxlite.newProject",
        "title": "Create New BoxLite Project...",
        "category": "BoxLite",
        "icon": "$(add)"
      },
      {
        "command": "boxlite.deploy",
        "title": "Deploy to Box",
        "category": "BoxLite",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "boxlite.deployFromTree",
        "title": "Deploy Workspace to this Box",
        "category": "BoxLite",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "boxlite.createBox",
        "title": "Add New Box...",
        "category": "BoxLite",
        "icon": "$(add)"
      },
      {
        "command": "boxlite.createBoxWithOptions",
        "title": "Create Box with Options...",
        "category": "BoxLite",
        "icon": "$(gear)"
      },
      {
        "command": "boxlite.startBox",
        "title": "Start Box",
        "category": "BoxLite",
        "icon": "$(play)"
      },
      {
        "command": "boxlite.stopBox",
        "title": "Stop Box",
        "category": "BoxLite",
        "icon": "$(primitive-square)"
      },
      {
        "command": "boxlite.restartApp",
        "title": "Restart Application",
        "category": "BoxLite",
        "icon": "$(sync)"
      },
      {
        "command": "boxlite.deleteBox",
        "title": "Delete Box",
        "category": "BoxLite",
        "icon": "$(trash)"
      },
      {
        "command": "boxlite.openUrl",
        "title": "Open Public URL",
        "category": "BoxLite",
        "icon": "$(globe)"
      },
      {
        "command": "boxlite.copyUrl",
        "title": "Copy Public URL",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.copyAccessToken",
        "title": "Copy Private Access Token",
        "category": "BoxLite",
        "icon": "$(key)"
      },
      {
        "command": "boxlite.setAccess",
        "title": "Configure Inbound / Public Access...",
        "category": "BoxLite",
        "icon": "$(lock)"
      },
      {
        "command": "boxlite.configureOutbound",
        "title": "Configure Outbound Network Allowlist...",
        "category": "BoxLite",
        "icon": "$(shield)"
      },
      {
        "command": "boxlite.streamLogs",
        "title": "Stream Logs",
        "category": "BoxLite",
        "icon": "$(output)"
      },
      {
        "command": "boxlite.stopLogs",
        "title": "Stop Streaming Logs",
        "category": "BoxLite",
        "icon": "$(close)"
      },
      {
        "command": "boxlite.execCommand",
        "title": "Execute Command in Box...",
        "category": "BoxLite",
        "icon": "$(terminal)"
      },
      {
        "command": "boxlite.inspectBox",
        "title": "Inspect Box (JSON)",
        "category": "BoxLite",
        "icon": "$(json)"
      },
      {
        "command": "boxlite.openDocs",
        "title": "Open Documentation",
        "category": "BoxLite",
        "icon": "$(book)"
      },
      {
        "command": "boxlite.refreshVolumes",
        "title": "Refresh Volumes",
        "category": "BoxLite",
        "icon": "$(refresh)"
      },
      {
        "command": "boxlite.createVolume",
        "title": "Add New Volume...",
        "category": "BoxLite",
        "icon": "$(add)"
      },
      {
        "command": "boxlite.deleteVolume",
        "title": "Delete Volume",
        "category": "BoxLite",
        "icon": "$(trash)"
      },
      {
        "command": "boxlite.inspectVolume",
        "title": "Inspect Volume (JSON)",
        "category": "BoxLite",
        "icon": "$(json)"
      },
      {
        "command": "boxlite.copyVolumeId",
        "title": "Copy Volume ID",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.copyVolumeName",
        "title": "Copy Volume Name",
        "category": "BoxLite",
        "icon": "$(tag)"
      },
      {
        "command": "boxlite.addVolumeToBox",
        "title": "Mount Volume in Box...",
        "category": "BoxLite",
        "icon": "$(link)"
      },
      {
        "command": "boxlite.refreshImages",
        "title": "Refresh Images",
        "category": "BoxLite",
        "icon": "$(refresh)"
      },
      {
        "command": "boxlite.addImage",
        "title": "Use Your Own Image...",
        "category": "BoxLite",
        "icon": "$(add)"
      },
      {
        "command": "boxlite.createBoxFromImage",
        "title": "Create Box from Image...",
        "category": "BoxLite",
        "icon": "$(plus)"
      },
      {
        "command": "boxlite.setDefaultImage",
        "title": "Set as Default Image",
        "category": "BoxLite",
        "icon": "$(star)"
      },
      {
        "command": "boxlite.copyImageName",
        "title": "Copy Image Reference",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.inspectImage",
        "title": "Inspect Image (JSON)",
        "category": "BoxLite",
        "icon": "$(json)"
      },
      {
        "command": "boxlite.pinImageAlias",
        "title": "Pin Image Alias...",
        "category": "BoxLite",
        "icon": "$(tag)"
      },
      {
        "command": "boxlite.removeImage",
        "title": "Delete Image",
        "category": "BoxLite",
        "icon": "$(trash)"
      },
      {
        "command": "boxlite.addRegistryLogin",
        "title": "Connect Private Registry...",
        "category": "BoxLite",
        "icon": "$(key)"
      },
      {
        "command": "boxlite.refreshCheckpoints",
        "title": "Refresh Checkpoints",
        "category": "BoxLite",
        "icon": "$(refresh)"
      },
      {
        "command": "boxlite.createCheckpoint",
        "title": "Create Checkpoint...",
        "category": "BoxLite",
        "icon": "$(add)"
      },
      {
        "command": "boxlite.createCheckpointFromBox",
        "title": "Save Checkpoint from Box...",
        "category": "BoxLite",
        "icon": "$(archive)"
      },
      {
        "command": "boxlite.createBoxFromCheckpoint",
        "title": "Create Box from Checkpoint...",
        "category": "BoxLite",
        "icon": "$(repo-forked)"
      },
      {
        "command": "boxlite.forkFleetFromCheckpoint",
        "title": "Fork Worker Fleet from Checkpoint...",
        "category": "BoxLite",
        "icon": "$(organization)"
      },
      {
        "command": "boxlite.inspectCheckpoint",
        "title": "Inspect Checkpoint (JSON)",
        "category": "BoxLite",
        "icon": "$(json)"
      },
      {
        "command": "boxlite.copyCheckpointId",
        "title": "Copy Checkpoint ID",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.copyCheckpointName",
        "title": "Copy Checkpoint Name",
        "category": "BoxLite",
        "icon": "$(tag)"
      },
      {
        "command": "boxlite.deleteCheckpoint",
        "title": "Delete Checkpoint",
        "category": "BoxLite",
        "icon": "$(trash)"
      },
      {
        "command": "boxlite.refreshSecrets",
        "title": "Refresh Secrets",
        "category": "BoxLite",
        "icon": "$(refresh)"
      },
      {
        "command": "boxlite.createSecret",
        "title": "Create Proxy Secret",
        "category": "BoxLite",
        "icon": "$(shield)"
      },
      {
        "command": "boxlite.createBoxWithSecret",
        "title": "Create Box with Secret",
        "category": "BoxLite",
        "icon": "$(vm)"
      },
      {
        "command": "boxlite.addSecretToProject",
        "title": "Add Secret Config to boxlite.json",
        "category": "BoxLite",
        "icon": "$(json)"
      },
      {
        "command": "boxlite.rotateSecret",
        "title": "Rotate Proxy Secret",
        "category": "BoxLite",
        "icon": "$(sync)"
      },
      {
        "command": "boxlite.copySecretPlaceholder",
        "title": "Copy Secret Placeholder",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.copySecretHeader",
        "title": "Copy Guest Header",
        "category": "BoxLite",
        "icon": "$(copy)"
      },
      {
        "command": "boxlite.copySecretSnippet",
        "title": "Copy Secret Usage Snippet",
        "category": "BoxLite",
        "icon": "$(code)"
      },
      {
        "command": "boxlite.verifySecretInjection",
        "title": "Verify Secret Proxy Injection",
        "category": "BoxLite",
        "icon": "$(beaker)"
      },
      {
        "command": "boxlite.deleteSecret",
        "title": "Delete Proxy Secret",
        "category": "BoxLite",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "boxlite.setApiKey",
          "when": "view == boxlite.accountView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.refresh",
          "when": "view == boxlite.accountView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.refresh",
          "when": "view == boxlite.boxesView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.createBox",
          "when": "view == boxlite.boxesView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.createBoxWithOptions",
          "when": "view == boxlite.boxesView",
          "group": "navigation@3"
        },
        {
          "command": "boxlite.deploy",
          "when": "view == boxlite.boxesView",
          "group": "navigation@4"
        },
        {
          "command": "boxlite.refreshImages",
          "when": "view == boxlite.imagesView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.addImage",
          "when": "view == boxlite.imagesView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.addRegistryLogin",
          "when": "view == boxlite.imagesView",
          "group": "navigation@3"
        },
        {
          "command": "boxlite.refreshVolumes",
          "when": "view == boxlite.volumesView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.createVolume",
          "when": "view == boxlite.volumesView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.refreshCheckpoints",
          "when": "view == boxlite.checkpointsView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.createCheckpoint",
          "when": "view == boxlite.checkpointsView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.refreshSecrets",
          "when": "view == boxlite.secretsView",
          "group": "navigation@1"
        },
        {
          "command": "boxlite.createSecret",
          "when": "view == boxlite.secretsView",
          "group": "navigation@2"
        },
        {
          "command": "boxlite.verifySecretInjection",
          "when": "view == boxlite.secretsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "boxlite.createBox",
          "when": "view == boxlite.accountView && viewItem == 'account-signed-in'",
          "group": "account@1"
        },
        {
          "command": "boxlite.createBoxWithOptions",
          "when": "view == boxlite.accountView && viewItem == 'account-signed-in'",
          "group": "account@2"
        },
        {
          "command": "boxlite.addImage",
          "when": "view == boxlite.accountView && viewItem == 'account-signed-in'",
          "group": "account@3"
        },
        {
          "command": "boxlite.createVolume",
          "when": "view == boxlite.accountView && viewItem == 'account-signed-in'",
          "group": "account@4"
        },
        {
          "command": "boxlite.signOut",
          "when": "view == boxlite.accountView && viewItem == 'account-signed-in'",
          "group": "account@5"
        },
        {
          "command": "boxlite.selectApiKey",
          "when": "view == boxlite.accountView && viewItem == 'apikey'",
          "group": "1_select@1"
        },
        {
          "command": "boxlite.removeApiKey",
          "when": "view == boxlite.accountView && (viewItem == 'apikey' || viewItem == 'apikey-active')",
          "group": "9_danger@1"
        },
        {
          "command": "boxlite.openUrl",
          "when": "view == boxlite.boxesView && viewItem =~ /.*canOpenUrl.*/",
          "group": "0_action@1"
        },
        {
          "command": "boxlite.copyUrl",
          "when": "view == boxlite.boxesView && viewItem =~ /.*canOpenUrl.*/",
          "group": "0_action@2"
        },
        {
          "command": "boxlite.copyAccessToken",
          "when": "view == boxlite.boxesView && viewItem =~ /.*hasToken.*/",
          "group": "0_action@3"
        },
        {
          "command": "boxlite.stopBox",
          "when": "view == boxlite.boxesView && (viewItem =~ /.*canStop.*/ || viewItem =~ /.*isRunning.*/)",
          "group": "inline@1"
        },
        {
          "command": "boxlite.startBox",
          "when": "view == boxlite.boxesView && (viewItem =~ /.*canStart.*/ || viewItem =~ /.*isStopped.*/)",
          "group": "inline@1"
        },
        {
          "command": "boxlite.deployFromTree",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "1_manage@1"
        },
        {
          "command": "boxlite.stopBox",
          "when": "view == boxlite.boxesView && (viewItem =~ /.*canStop.*/ || viewItem =~ /.*isRunning.*/)",
          "group": "1_manage@2"
        },
        {
          "command": "boxlite.startBox",
          "when": "view == boxlite.boxesView && (viewItem =~ /.*canStart.*/ || viewItem =~ /.*isStopped.*/)",
          "group": "1_manage@3"
        },
        {
          "command": "boxlite.restartApp",
          "when": "view == boxlite.boxesView && viewItem =~ /.*isRunning.*/",
          "group": "1_manage@4"
        },
        {
          "command": "boxlite.streamLogs",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "2_inspect@1"
        },
        {
          "command": "boxlite.stopLogs",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "2_inspect@2"
        },
        {
          "command": "boxlite.execCommand",
          "when": "view == boxlite.boxesView && viewItem =~ /.*isRunning.*/",
          "group": "2_inspect@3"
        },
        {
          "command": "boxlite.inspectBox",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "2_inspect@4"
        },
        {
          "command": "boxlite.createCheckpointFromBox",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "2_inspect@5"
        },
        {
          "command": "boxlite.setAccess",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "3_network@1"
        },
        {
          "command": "boxlite.configureOutbound",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "3_network@2"
        },
        {
          "command": "boxlite.deleteBox",
          "when": "view == boxlite.boxesView && viewItem =~ /^box-.*/",
          "group": "9_danger@1"
        },
        {
          "command": "boxlite.createBoxFromImage",
          "when": "view == boxlite.imagesView && viewItem =~ /^image-item.*/",
          "group": "inline@1"
        },
        {
          "command": "boxlite.createBoxFromImage",
          "when": "view == boxlite.imagesView && viewItem =~ /^image-item.*/",
          "group": "1_actions@1"
        },
        {
          "command": "boxlite.setDefaultImage",
          "when": "view == boxlite.imagesView && viewItem =~ /^image-item.*/ && !(viewItem =~ /.*image-default.*/)",
          "group": "1_actions@2"
        },
        {
          "command": "boxlite.pinImageAlias",
          "when": "view == boxlite.imagesView && viewItem =~ /.*image-custom.*/",
          "group": "1_actions@3"
        },
        {
          "command": "boxlite.inspectImage",
          "when": "view == boxlite.imagesView && viewItem =~ /^image-item.*/",
          "group": "2_inspect@1"
        },
        {
          "command": "boxlite.copyImageName",
          "when": "view == boxlite.imagesView && viewItem =~ /^image-item.*/",
          "group": "3_copy@1"
        },
        {
          "command": "boxlite.removeImage",
          "when": "view == boxlite.imagesView && viewItem =~ /.*image-custom.*/",
          "group": "9_danger@1"
        },
        {
          "command": "boxlite.addVolumeToBox",
          "when": "view == boxlite.volumesView && viewItem =~ /^volume-.*/",
          "group": "1_mount@1"
        },
        {
          "command": "boxlite.inspectVolume",
          "when": "view == boxlite.volumesView && viewItem =~ /^volume-.*/",
          "group": "2_inspect@1"
        },
        {
          "command": "boxlite.copyVolumeId",
          "when": "view == boxlite.volumesView && viewItem =~ /^volume-.*/",
          "group": "3_copy@1"
        },
        {
          "command": "boxlite.copyVolumeName",
          "when": "view == boxlite.volumesView && viewItem =~ /^volume-.*/",
          "group": "3_copy@2"
        },
        {
          "command": "boxlite.deleteVolume",
          "when": "view == boxlite.volumesView && viewItem =~ /^volume-.*/",
          "group": "9_danger@1"
        },
        {
          "command": "boxlite.createBoxFromCheckpoint",
          "when": "view == boxlite.checkpointsView && viewItem =~ /.*checkpoint-ready.*/",
          "group": "inline@1"
        },
        {
          "command": "boxlite.createBoxFromCheckpoint",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "1_restore@1"
        },
        {
          "command": "boxlite.forkFleetFromCheckpoint",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "1_restore@2"
        },
        {
          "command": "boxlite.inspectCheckpoint",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "2_inspect@1"
        },
        {
          "command": "boxlite.copyCheckpointId",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "3_copy@1"
        },
        {
          "command": "boxlite.copyCheckpointName",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "3_copy@2"
        },
        {
          "command": "boxlite.deleteCheckpoint",
          "when": "view == boxlite.checkpointsView && viewItem =~ /^checkpoint-item.*/",
          "group": "9_danger@1"
        },
        {
          "command": "boxlite.createBoxWithSecret",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "1_use@1"
        },
        {
          "command": "boxlite.addSecretToProject",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "1_use@2"
        },
        {
          "command": "boxlite.copySecretPlaceholder",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "2_copy@1"
        },
        {
          "command": "boxlite.copySecretHeader",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "2_copy@2"
        },
        {
          "command": "boxlite.copySecretSnippet",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "2_copy@3"
        },
        {
          "command": "boxlite.rotateSecret",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "3_manage@1"
        },
        {
          "command": "boxlite.deleteSecret",
          "when": "view == boxlite.secretsView && viewItem =~ /^secret-item.*/",
          "group": "9_danger@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "BoxLite",
      "properties": {
        "boxlite.restUrl": {
          "type": "string",
          "default": "https://api.boxlite.ai",
          "description": "BoxLite Cloud REST API URL (e.g. https://api.boxlite.ai)"
        },
        "boxlite.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to python executable to run the BoxLite SDK bridge (leave empty for automatic resolution)"
        },
        "boxlite.defaultPort": {
          "type": "number",
          "default": 8080,
          "description": "Default port for app server tunnels"
        },
        "boxlite.autoStop": {
          "type": "number",
          "default": 0,
          "description": "Default auto_stop seconds for created boxes (0 = never auto stop, or >= 60 seconds)"
        },
        "boxlite.defaultImage": {
